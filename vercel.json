{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": null,
  "framework": null,
  "regions": ["sin1"],
  "git": { "deploymentEnabled": { "claude/**": false } },
  "crons": [
    { "path": "/api/cron/daily", "schedule": "30 13 * * *" },
    { "path": "/api/cron/clockout", "schedule": "0 10 * * *" },
    { "path": "/api/cron/backup", "schedule": "0 20 * * *" },
    { "path": "/api/cron/fusionsolar", "schedule": "0 21 * * *" },
    { "path": "/api/cron/fusionsolar?job=histday", "schedule": "30 21 * * *" }
  ],
  "functions": {
    "api/cron/backup.mjs": { "maxDuration": 60 },
    "api/cron/fusionsolar.mjs": { "maxDuration": 60 },
    "api/fusionsolar/sync.mjs": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
